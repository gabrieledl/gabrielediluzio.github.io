<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <meta name="description"
        content="Gabriele Di Luzio — PhD Candidate in Statistics. Research in financial econometrics, copulas, covariance estimation, systemic risk and climate finance.">

  <title>Gabriele Di Luzio</title>

  <style>
    :root {
      --bg: #f6f3ee;
      --paper: #fffdf9;
      --text: #20252b;
      --muted: #687078;
      --accent: #8c3d2f;
      --accent-dark: #672c22;
      --navy: #25364a;
      --line: #ded8cf;
      --soft: #ece6dd;
      --max: 1180px;
      --sidebar: 310px;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      color: var(--text);
      background:
        linear-gradient(90deg, rgba(140, 61, 47, 0.035) 1px, transparent 1px),
        linear-gradient(rgba(140, 61, 47, 0.035) 1px, transparent 1px),
        var(--bg);
      background-size: 34px 34px;
      font-family: Arial, Helvetica, sans-serif;
      line-height: 1.65;
    }

    a {
      color: var(--accent);
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;
    }

    a:hover {
      color: var(--accent-dark);
    }

    .site {
      display: grid;
      grid-template-columns: var(--sidebar) minmax(0, 1fr);
      width: min(var(--max), calc(100% - 40px));
      margin: 0 auto;
      min-height: 100vh;
      background: var(--paper);
      border-left: 1px solid var(--line);
      border-right: 1px solid var(--line);
      box-shadow: 0 0 50px rgba(46, 40, 33, 0.08);
    }

    .sidebar {
      position: sticky;
      top: 0;
      align-self: start;
      height: 100vh;
      padding: 54px 34px 32px;
      border-right: 1px solid var(--line);
      background: #f0ebe3;
      overflow-y: auto;
    }

    .portrait {
      position: relative;
      width: 178px;
      height: 178px;
      margin-bottom: 26px;
      overflow: hidden;
      border: 1px solid #cabfb3;
      border-radius: 50%;
      background:
        radial-gradient(circle at 35% 28%, #b66b5d, transparent 25%),
        linear-gradient(145deg, var(--navy), #50647b);
      box-shadow: 0 14px 30px rgba(37, 54, 74, 0.18);
    }

    .portrait-fallback {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      color: white;
      font-family: Georgia, "Times New Roman", serif;
      font-size: 3.3rem;
      letter-spacing: -0.08em;
    }

    .portrait img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 50% 48%;
      z-index: 2;
    }

    .name {
      margin: 0;
      color: var(--navy);
      font-family: Georgia, "Times New Roman", serif;
      font-size: 2rem;
      line-height: 1.02;
      letter-spacing: -0.035em;
    }

    .role {
      margin: 12px 0 0;
      color: var(--muted);
      font-size: 0.95rem;
      line-height: 1.55;
    }

    .affiliation {
      display: block;
      margin-top: 6px;
      color: var(--navy);
      font-weight: 700;
    }

    .sidebar-rule {
      width: 50px;
      height: 3px;
      margin: 25px 0;
      border: 0;
      background: var(--accent);
    }

    .nav {
      display: grid;
      gap: 3px;
      margin: 0 0 28px;
    }

    .nav a {
      display: block;
      padding: 7px 0;
      color: #454b52;
      font-size: 0.91rem;
      font-weight: 700;
      text-decoration: none;
    }

    .nav a:hover {
      color: var(--accent);
      transform: translateX(3px);
    }

    .profiles {
      display: grid;
      gap: 8px;
      font-size: 0.88rem;
    }

    .profiles a {
      width: fit-content;
      color: var(--muted);
      text-decoration: none;
    }

    .profiles a:hover {
      color: var(--accent);
    }

    .content {
      min-width: 0;
      padding: 70px 72px 60px;
    }

    .hero {
      padding-bottom: 54px;
      border-bottom: 1px solid var(--line);
    }

    .kicker {
      margin: 0 0 12px;
      color: var(--accent);
      font-size: 0.76rem;
      font-weight: 800;
      letter-spacing: 0.15em;
      text-transform: uppercase;
    }

    .hero h1 {
      max-width: 760px;
      margin: 0;
      color: var(--navy);
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(2.7rem, 6vw, 5.2rem);
      line-height: 0.98;
      letter-spacing: -0.055em;
    }

    .hero-lead {
      max-width: 760px;
      margin: 27px 0 0;
      color: #4e565e;
      font-family: Georgia, "Times New Roman", serif;
      font-size: 1.28rem;
      line-height: 1.65;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 30px;
    }

    .button {
      display: inline-flex;
      align-items: center;
      min-height: 43px;
      padding: 0 17px;
      border: 1px solid var(--navy);
      color: white;
      background: var(--navy);
      font-size: 0.88rem;
      font-weight: 700;
      text-decoration: none;
      transition: 0.18s ease;
    }

    .button:hover {
      color: white;
      background: var(--accent);
      border-color: var(--accent);
      transform: translateY(-2px);
    }

    .button.secondary {
      color: var(--navy);
      background: transparent;
    }

    .button.secondary:hover {
      color: white;
      background: var(--accent);
      border-color: var(--accent);
    }

    section {
      padding: 54px 0;
      border-bottom: 1px solid var(--line);
      scroll-margin-top: 20px;
    }

    section:last-of-type {
      border-bottom: 0;
    }

    .section-head {
      display: grid;
      grid-template-columns: 155px minmax(0, 1fr);
      gap: 28px;
      margin-bottom: 30px;
    }

    .section-number {
      color: var(--accent);
      font-size: 0.75rem;
      font-weight: 800;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    h2 {
      margin: 0;
      color: var(--navy);
      font-family: Georgia, "Times New Roman", serif;
      font-size: 2.15rem;
      line-height: 1.15;
      letter-spacing: -0.035em;
    }

    .section-body {
      margin-left: 183px;
    }

    .section-body > p:first-child {
      margin-top: 0;
    }

    .section-body p {
      max-width: 780px;
      color: #4f565d;
    }

    .interest-list {
      display: flex;
      flex-wrap: wrap;
      gap: 9px;
      margin-top: 24px;
    }

    .interest {
      padding: 7px 11px;
      border: 1px solid #d4c8bc;
      color: #4c5054;
      background: #f7f1e9;
      font-size: 0.81rem;
      font-weight: 700;
    }

    .papers {
      display: grid;
      gap: 0;
    }

    .paper {
      display: grid;
      grid-template-columns: 44px minmax(0, 1fr);
      gap: 18px;
      padding: 25px 0;
      border-top: 1px solid var(--line);
    }

    .paper:first-child {
      border-top: 0;
      padding-top: 0;
    }

    .paper-index {
      color: #a39a91;
      font-family: Georgia, "Times New Roman", serif;
      font-size: 1.25rem;
    }

    .paper h3 {
      margin: 0;
      color: var(--navy);
      font-family: Georgia, "Times New Roman", serif;
      font-size: 1.25rem;
      line-height: 1.35;
      font-weight: 700;
    }

    .paper-meta {
      margin-top: 6px;
      color: var(--accent);
      font-size: 0.83rem;
      font-weight: 800;
      letter-spacing: 0.02em;
    }

    .paper p {
      margin: 10px 0 0;
      color: #5c6369;
      font-size: 0.94rem;
    }

    .paper-links {
      display: flex;
      flex-wrap: wrap;
      gap: 13px;
      margin-top: 12px;
      font-size: 0.84rem;
      font-weight: 700;
    }

    .timeline {
      display: grid;
      gap: 0;
    }

    .timeline-item {
      display: grid;
      grid-template-columns: 122px minmax(0, 1fr);
      gap: 22px;
      padding: 21px 0;
      border-top: 1px solid var(--line);
    }

    .timeline-item:first-child {
      border-top: 0;
      padding-top: 0;
    }

    .timeline-date {
      color: var(--accent);
      font-size: 0.83rem;
      font-weight: 800;
    }

    .timeline-item h3 {
      margin: 0;
      color: var(--navy);
      font-family: Georgia, "Times New Roman", serif;
      font-size: 1.08rem;
    }

    .timeline-item p {
      margin: 5px 0 0;
      color: var(--muted);
      font-size: 0.91rem;
    }

    .contact-card {
      padding: 30px;
      border-left: 4px solid var(--accent);
      background: #f3ede5;
    }

    .contact-card p {
      margin: 0;
    }

    footer {
      padding-top: 24px;
      color: #81868a;
      font-size: 0.79rem;
    }

    .mobile-header {
      display: none;
    }

    @media (max-width: 900px) {
      .site {
        display: block;
        width: min(100%, 760px);
      }

      .sidebar {
        position: static;
        width: auto;
        height: auto;
        padding: 38px 30px;
        border-right: 0;
        border-bottom: 1px solid var(--line);
      }

      .portrait {
        width: 130px;
        height: 130px;
      }

      .nav {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 18px;
      }

      .content {
        padding: 50px 38px;
      }
    }

    @media (max-width: 620px) {
      .site {
        width: 100%;
        border: 0;
      }

      .sidebar {
        padding: 30px 22px;
      }

      .content {
        padding: 42px 22px;
      }

      .hero h1 {
        font-size: 3rem;
      }

      .hero-lead {
        font-size: 1.08rem;
      }

      .section-head {
        grid-template-columns: 1fr;
        gap: 7px;
      }

      .section-body {
        margin-left: 0;
      }

      .timeline-item {
        grid-template-columns: 1fr;
        gap: 5px;
      }

      .paper {
        grid-template-columns: 32px minmax(0, 1fr);
        gap: 12px;
      }
    }
  </style>
</head>

<body>
  <div class="site">

    <aside class="sidebar">
      <!--
        PROFILE PHOTO:
        Upload your photo to the main folder of the GitHub repository
        and name it exactly: profile.jpg
        To use another filename, replace profile.jpg in src below.
      -->
      <div class="portrait">
        <div class="portrait-fallback">GDL</div>
        <img src="profile.jpg"
             alt="Gabriele Di Luzio"
             onerror="this.style.display='none'">
      </div>

      <h1 class="name">Gabriele<br>Di Luzio</h1>

      <p class="role">
        PhD Candidate in Statistics
        <span class="affiliation">Sapienza University of Rome</span>
      </p>

      <hr class="sidebar-rule">

      <nav class="nav" aria-label="Main navigation">
        <a href="#about">About</a>
        <a href="#working-papers">Working Papers</a>
        <a href="#research">Research Projects</a>
        <a href="#education">Education</a>
        <a href="#contact">Contact</a>
      </nav>

      <div class="profiles">
        <!--
          CURRICULUM VITAE:
          Upload the PDF to the main folder of the GitHub repository
          and name it exactly: cv.pdf
          To use another filename, replace cv.pdf in both links in this file.
        -->
        <a href="cv.pdf" target="_blank" rel="noopener">Curriculum Vitae</a>
        <a href="mailto:gabriele.diluzio@uniroma1.it">Email</a>
        <a href="https://github.com/gabrieledl" target="_blank" rel="noopener">GitHub</a>

        <!-- Replace # with your real profiles -->
        <a href="https://www.linkedin.com/in/gabriele-di-luzio" target="_blank" rel="noopener">LinkedIn</a>
      </div>
    </aside>

    <main class="content">

      <header class="hero">
        <p class="kicker">Financial Econometrics · Dependence Modelling</p>

        <h1>
          Dynamic dependence,
          climate risk and
          financial markets.
        </h1>

        <p class="hero-lead">
          I develop econometric methods for measuring nonlinear,
          time-varying and tail dependence in financial systems.
        </p>

        <div class="hero-actions">
          <a class="button" href="#working-papers">View research</a>
          <a class="button secondary" href="cv.pdf" target="_blank" rel="noopener">Download CV</a>
        </div>
      </header>

      <section id="about">
        <div class="section-head">
          <div class="section-number">01 · About</div>
          <h2>About me</h2>
        </div>

        <div class="section-body">
          <p>
            I am a PhD Candidate in Statistics at the Department of
            Statistical Sciences of Sapienza University of Rome.
            In 2026, I was a Visiting PhD Student at the Department of
            Statistics of Ludwig Maximilian University of Munich and the Munich Center for Machine Learning.
          </p>

          <p>
            My research focuses on financial econometrics, dynamic copula
            models, high-dimensional covariance estimation, systemic risk
            and the transmission of climate-related information across
            financial markets.
          </p>

          <div class="interest-list">
            <span class="interest">Financial econometrics</span>
            <span class="interest">Copula models</span>
            <span class="interest">GAS models</span>
            <span class="interest">Covariance estimation</span>
            <span class="interest">Systemic risk</span>
            <span class="interest">Climate finance</span>
          </div>
        </div>
      </section>

      <section id="working-papers">
        <div class="section-head">
          <div class="section-number">02 · Papers</div>
          <h2>Working papers</h2>
        </div>

        <div class="section-body papers">

          <article class="paper">
            <div class="paper-index">01</div>
            <div>
              <h3>Modelling the Impact of Climate News on CDS Dependence: A Generalized Autoregressive Score Approach</h3>
              <div class="paper-meta">WORKING PAPER</div>
              <p>
                A score-driven factor copula model for studying how physical
                and transition climate risks affect dependence and joint
                distress across a broad panel of European credit default swaps.
              </p>
              <div class="paper-links">
                <!-- Example:
                <a href="papers/climate-cds.pdf" target="_blank">PDF</a>
                -->
                <a href="mailto:gabriele.diluzio@uniroma1.it?subject=Climate%20CDS%20paper">Request paper</a>
              </div>
            </div>
          </article>

          <article class="paper">
            <div class="paper-index">02</div>
            <div>
              <h3>Dynamic Conditional SKEPTIC</h3>
              <div class="paper-meta">WORKING PAPER</div>
              <p>
                A high-dimensional framework combining volatility dynamics
                and robust rank-based dependence measures for dynamic
                covariance matrix estimation.
              </p>
              <div class="paper-links">
                <a href="https://arxiv.org/pdf/2512.11648"
                   target="_blank"
                   rel="noopener">PDF</a>
              </div>
            </div>
          </article>

          <article class="paper">
            <div class="paper-index">03</div>
            <div>
              <h3>Robust Semiparametric Graphical Models with Skew-Elliptical Distributions</h3>
              <div class="paper-meta">WORKING PAPER</div>
              <p>
                A robust semiparametric framework for graphical modelling
                under skew-elliptical distributions.
              </p>
              <div class="paper-links">
                <a href="https://arxiv.org/pdf/2501.08033"
                   target="_blank"
                   rel="noopener">PDF</a>
              </div>
            </div>
          </article>

        </div>
      </section>

      <section id="research">
        <div class="section-head">
          <div class="section-number">03 · Projects</div>
          <h2>Research in progress</h2>
        </div>

        <div class="section-body papers">

          <article class="paper">
            <div class="paper-index">01</div>
            <div>
              <h3>Tail Dependence and Systemic Credit Risk</h3>
              <div class="paper-meta">RESEARCH PROJECT</div>
              <p>
                Measurement of dynamic tail dependence and joint distress
                probabilities across firms, sectors and periods of market stress.
              </p>
            </div>
          </article>

          <article class="paper">
            <div class="paper-index">02</div>
            <div>
              <h3>Systemic Illiquidity and Flexible Copula Models</h3>
              <div class="paper-meta">WORK IN PROGRESS</div>
              <p>
                Integration of realized illiquidity, latent systemic factors
                and nonlinear dependence into systemic-risk measurement.
              </p>
            </div>
          </article>

        </div>
      </section>

      <section id="education">
        <div class="section-head">
          <div class="section-number">04 · Background</div>
          <h2>Education and experience</h2>
        </div>

        <div class="section-body timeline">

          <div class="timeline-item">
            <div class="timeline-date">2023–Present</div>
            <div>
              <h3>PhD in Statistics</h3>
              <p>
                Sapienza University of Rome,
                Department of Statistical Sciences.
              </p>
            </div>
          </div>

          <div class="timeline-item">
            <div class="timeline-date">2026</div>
            <div>
              <h3>Visiting PhD Student</h3>
              <p>
                Ludwig Maximilian University of Munich, Department of Statistics and Munich Center for Machine Learning.
              </p>
            </div>
          </div>

          <div class="timeline-item">
            <div class="timeline-date">2020–2023</div>
            <div>
              <h3>MSc in Quantitative Finance</h3>
              <p>
                Sapienza University of Rome · 110/110 cum laude.
              </p>
            </div>
          </div>

          <div class="timeline-item">
            <div class="timeline-date">2017–2020</div>
            <div>
              <h3>BSc in Statistics for Economics, Finance and Insurance</h3>
              <p>
                Sapienza University of Rome · 97/110.
              </p>
            </div>
          </div>

        </div>
      </section>

      <section id="contact">
        <div class="section-head">
          <div class="section-number">05 · Contact</div>
          <h2>Contact</h2>
        </div>

        <div class="section-body">
          <div class="contact-card">
            <p>
              For research discussions, seminars, collaborations or
              professional opportunities:
              <a href="mailto:gabriele.diluzio@uniroma1.it">
                gabriele.diluzio@uniroma1.it
              </a>
            </p>
          </div>
        </div>
      </section>

      <footer>
        © <span id="year"></span> Gabriele Di Luzio.
        Last updated July 2026.
      </footer>

    </main>
  </div>

  <script>
    document.getElementById("year").textContent =
      new Date().getFullYear();
  </script>
</body>
</html>
